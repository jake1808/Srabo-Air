# Production environment — copy to .env.production on the VPS and fill in real values.
# NEVER commit .env.production (it is gitignored).

# PostgreSQL container (creates the database on first start)
POSTGRES_USER=stabo
POSTGRES_PASSWORD=<strong-unique-password>
POSTGRES_DB=stabo_awb

# Flask app connection (DB_HOST/DB_PORT are set by docker-compose.prod.yml — not needed here)
DB_USER=stabo
DB_PASSWORD=<same-as-POSTGRES_PASSWORD>
DB_NAME=stabo_awb

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<long-random-string>
